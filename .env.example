# Server Configuration
NODE_ENV=development
ENFORCE_WHATSAPP_VERIFICATION=false
PORT=81
CORS_ORIGIN=*

# Database (DynamoDB)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# Prefer leaving both AWS key fields empty in hosted environments and attach
# an IAM role/workload identity with least-privilege DynamoDB permissions.
# Table Names (REQUIRED)
DYNAMO_DB_USERS=fcs_users
DYNAMO_DB_CREDITS=fcs_credits
DYNAMO_DB_TITLES=fcs_credit_titles
DYNAMO_DB_SESSIONS=fcs_sessions
DYNAMO_DB_POLICIES=fcs_credit_policies
DYNAMO_DB_NOTIFICATIONS=fcs_notifications

# Authentication (JWT)
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=1h
REQUIRE_SESSION_VALIDATION=false
SESSION_TIMEOUT=3600000
MAX_ACTIVE_SESSIONS=5

# Official export signatures (minimum 32 random bytes) and public frontend URL
EXPORT_SIGNING_SECRET=
PUBLIC_APP_URL=http://localhost:9002

# Email Configuration (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_password_or_app_password
EMAIL_SECURE=false
EMAIL_DEBUG=false

# GitHub Assets Upload (for file storage)
ASSET_GH_OWNER=your_github_username
ASSET_GH_REPO=your_asset_repo_name
ASSET_GH_BRANCH=main
GITHUB_TOKEN=your_github_personal_access_token

# Self Pinger (Optional service to keep app alive)
SELF_PINGER_HOST=http://localhost:81

# Optional integrations. Keep all private values server-side only.
FIREBASE_SERVICE_ACCOUNT=
WHATSAPP_API_URL=
WHATSAPP_TOKEN=
WHATSAPP_TEST_PHONE=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=mailto:admin@example.com
